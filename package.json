{
  "name": "web-site",
  "version": "0.0.0",
  "description": "Webcomponent web-site following open-wc recommendations",
  "author": "web-site",
  "license": "MIT",
  "scripts": {
    "lint": "eslint --ext .ts,.html . --ignore-path .gitignore && prettier \"**/*.ts\" --check --ignore-path .gitignore",
    "format": "eslint --ext .ts,.html . --fix --ignore-path .gitignore && prettier \"**/*.ts\" --write --ignore-path .gitignore",
    "integrity": "sed -i '' \"s/SRI_HERE/sha256-$(curl -s https://d33wubrfki0l68.cloudfront.net/js/a5a4a2454e2bec14424f15b16fd91bb2399bc99e/web-site.js | openssl dgst -sha256 -binary | openssl base64 -A)/g\" dist/index.html",
    "build": "rimraf dist && tsc && rollup -c rollup.config.js && npm run analyze -- --exclude dist",
    "start:build": "web-dev-server --root-dir dist --app-index index.html --open",
    "analyze": "cem analyze --litelement",
    "start": "tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wds\""
  },
  "dependencies": {
    "@openpgp/web-stream-tools": "^0.3.1",
    "lit": "^3.3.3",
    "openpgp": "^6.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@open-wc/eslint-config": "^13.1.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-html": "^2.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@web/dev-server": "^1.0.0",
    "@web/rollup-plugin-copy": "^1.0.0",
    "@web/rollup-plugin-html": "^4.0.0",
    "@web/rollup-plugin-import-meta-assets": "^3.0.0",
    "@yushijinhun/three-minifier-rollup": "^0.4.0",
    "babel-plugin-template-html-minifier": "^4.1.0",
    "concurrently": "^10.0.4",
    "deepmerge": "^4.3.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^3.30.0",
    "rollup-plugin-summary": "^3.0.1",
    "rollup-plugin-workbox": "^9.0.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "extends": [
      "@open-wc",
      "prettier"
    ],
    "plugins": [
      "@typescript-eslint"
    ],
    "rules": {
      "no-unused-vars": "off",
      "@typescript-eslint/no-unused-vars": [
        "error"
      ],
      "import/no-unresolved": "off",
      "import/extensions": [
        "error",
        "always",
        {
          "ignorePackages": true
        }
      ]
    }
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "customElements": "custom-elements.json"
}
